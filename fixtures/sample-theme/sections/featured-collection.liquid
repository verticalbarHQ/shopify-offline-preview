{%- assign featured = section.settings.collection -%}
<section class="section featured-collection" {{ section.shopify_attributes }}>
  <div class="section__header">
    <h2>{{ section.settings.heading | default: featured.title | escape }}</h2>
    {%- if featured.url -%}<a href="{{ featured.url }}">{{ 'collections.view_all' | t }}</a>{%- endif -%}
  </div>
  {%- if featured.products.size > 0 -%}
    <ul class="product-grid" style="--columns: {{ section.settings.columns }}">
      {%- for product in featured.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="muted">{{ 'collections.empty' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
