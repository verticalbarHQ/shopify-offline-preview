{
  "name": "@verticalbar/shopify-offline-preview",
  "version": "1.0.0",
  "description": "Unofficial offline preview for Shopify Online Store 2.0 themes: a dev server with an inspector, a CLI with JSON output and a browser playground.",
  "keywords": [
    "shopify",
    "liquid",
    "theme",
    "preview",
    "offline",
    "cli"
  ],
  "homepage": "https://verticalbarhq.github.io/shopify-offline-preview/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verticalbarHQ/shopify-offline-preview.git"
  },
  "bugs": "https://github.com/verticalbarHQ/shopify-offline-preview/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7",
  "bin": {
    "shopify-offline-preview": "dist/cli.js"
  },
  "exports": {
    "./render": {
      "types": "./dist/types/render/src/index.d.ts",
      "import": "./dist/render.js"
    },
    "./check": {
      "types": "./dist/types/check/src/index.d.ts",
      "import": "./dist/check.js"
    },
    "./browser": {
      "types": "./dist/types/check/src/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "fixtures/default"
  ],
  "scripts": {
    "generate": "node tools/generate-spec.mjs && tsx tools/generate-schemas.ts && tsx tools/generate-fixture.ts",
    "generate:check": "node tools/generate-spec.mjs --check && tsx tools/generate-schemas.ts --check && tsx tools/generate-fixture.ts --check",
    "docs:drift-check": "node tools/check-docs-drift.mjs",
    "oracle:instrumentation-check": "tsx tools/oracle/check-instrumentation.ts",
    "oracle:visual-compare": "tsx tools/oracle/visual-compare.ts",
    "oracle:record-verification": "tsx tools/oracle/record-verification.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "node tools/build.mjs",
    "prepack": "node tools/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "pnpm generate:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "benchmarks:fetch": "node tools/fetch-benchmarks.mjs",
    "benchmarks:check": "node tools/check-benchmarks.mjs",
    "benchmarks:render-check": "tsx tools/check-render-benchmarks.ts",
    "browser:render-smoke": "tsx tools/browser-render-smoke.ts",
    "license-guard": "node tools/license-guard.mjs",
    "test:network-off": "node tools/network-off.mjs",
    "browser:playground-check": "tsx tools/check-playground-browser.ts",
    "agent:contract-check": "tsx tools/check-agent-contracts.ts",
    "agent:eval": "tsx tools/agent-eval/run.ts",
    "browser:inspector-check": "tsx tools/check-inspector-matrix.ts",
    "test:browser-offline": "node tools/browser-network-off.mjs",
    "oracle:offline-check": "tsx tools/oracle/check-offline-comparison.ts",
    "parity:check": "tsx tools/check-parity.ts",
    "oracle:corpus-prepare": "tsx tools/oracle/prepare-corpus.ts",
    "language:check": "tsx tools/check-liquid-language.ts",
    "oracle:backup-audit": "tsx tools/oracle/check-backups.ts",
    "oracle:supplemental-backup-audit": "tsx tools/oracle/check-supplemental-backup.ts",
    "oracle:seed-prepare": "tsx tools/oracle/prepare-seed.ts",
    "oracle:seed-requests-prepare": "tsx tools/oracle/prepare-seed-requests.ts",
    "pages:artifact-check": "node tools/check-pages-artifact.mjs"
  },
  "dependencies": {
    "@shopify/liquid-html-parser": "2.10.2",
    "entities": "8.1.0",
    "jsonc-parser": "3.3.1",
    "liquidjs": "10.30.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "es-module-lexer": "3.0.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
