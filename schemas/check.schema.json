{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "supported": {
      "type": "boolean"
    },
    "specCommit": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pageType": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "filter",
                        "tag",
                        "object",
                        "object-property"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "known": {
                      "type": "boolean"
                    },
                    "oracleCases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "occurrences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "file",
                          "line"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "registered": {
                      "type": "boolean",
                      "const": true
                    },
                    "implemented": {
                      "type": "boolean",
                      "const": true
                    },
                    "serverOnly": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "known",
                    "oracleCases",
                    "verified",
                    "occurrences",
                    "registered",
                    "implemented",
                    "serverOnly"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "filter",
                        "tag",
                        "object",
                        "object-property"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "known": {
                      "type": "boolean"
                    },
                    "oracleCases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "occurrences": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "file",
                          "line"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "registered": {
                      "type": "boolean",
                      "const": false
                    },
                    "implemented": {
                      "type": "boolean",
                      "const": false
                    },
                    "serverOnly": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "known",
                    "oracleCases",
                    "verified",
                    "occurrences",
                    "registered",
                    "implemented",
                    "serverOnly"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "unimplementedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "pageType",
          "template",
          "files",
          "features",
          "unimplementedCount",
          "complete"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "file",
          "line",
          "nodeId",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "featureCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unimplementedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "featureCount",
        "unimplementedCount",
        "complete"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "supported",
    "specCommit",
    "pages",
    "diagnostics",
    "summary"
  ],
  "additionalProperties": false
}
