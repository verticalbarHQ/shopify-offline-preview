{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "html": {
      "type": "string"
    },
    "tree": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "file",
          "line",
          "nodeId",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "dataUsed": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "pageType": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "pageType",
        "template"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "html",
    "tree",
    "diagnostics",
    "dataUsed",
    "route"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "layout",
            "section-group",
            "section",
            "block",
            "snippet"
          ]
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "settingsPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "kind",
        "id",
        "type",
        "file",
        "settingsPath",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
